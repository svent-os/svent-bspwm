configuration {
    modi:                       "drun,run,filebrowser";
    terminal:                   "svent-bspwm-tool-terminal";
    icon-theme:                 "Svent";
    kb-clear-line:              "Control+a,Control+u,Control+w";
    kb-move-front:              "Home,KP_Home";
    kb-remove-to-sol:           "";
    font:                       "MesloLGS NF 10";
    display-drun:               " Apps";
    display-run:                "󰆍 Run";
    display-filebrowser:        "󰉖 Files";
    drun-display-format:        "{name}";
    sidebar-mode:                true;
    show-icons:                  true;
}

@theme "/dev/null"

* {
    bg:                         #191D22;
    fg:                         #d7dee7;
    fg-dim:                     #7E8995;
    selected:                   #e0564a;
    selected-text:              #ffffff;
    border-color:               #e0564a;
    active:                     #e0564a;
    button-bg:                  #10151d;

    background-color:           @bg;
    text-color:                 @fg;
}

window {
    transparency:                "real";
    width:                       360px;
    background-color:            @bg;
    border:                      1px;
    border-color:                @border-color;
    border-radius:               0px;
    padding:                     0px;
}

mainbox {
    children:                   [ inputbar, listview, mode-switcher ];
    background-color:           @bg;
    border-radius:               0px;
    spacing:                    0px;
}
inputbar {
    children:                   [ entry ];
    background-color:           @bg;
    border:                     0px 0px 1px 0px;
    border-color:               @border-color;
    padding:                    12px 16px;
    border-radius:              0px;
}

entry {
    placeholder:                " 󰍉 Search...";
    placeholder-color:          @fg-dim;
    text-color:                 @fg;
    background-color:           inherit;
    expand:                     true;
    vertical-align:             0.5;
    border-radius:              0px;
}

listview {
    columns:                    1;
    lines:                      7;
    cycle:                      false;
    dynamic:                    true;
    layout:                     vertical;
    padding:                    8px 8px;
    spacing:                    2px;
    background-color:           @bg;
    scrollbar:                  false;
    border-radius:              0px;
}

element {
    children:                   [ element-icon, element-text ];
    orientation:                horizontal;
    padding:                    7px 10px;
    spacing:                    10px;
    background-color:           inherit;
    text-color:                 @fg;
    border-radius:              0px;
}

element normal.normal {
    background-color:           @bg;
    text-color:                 @fg;
}

element selected.normal {
    background-color:           @selected;
    text-color:                 @selected-text;
    border-radius:              0px;
}

element-icon {
    size:                       1.2em;
    vertical-align:             0.5;
    background-color:           inherit;
}

element-text {
    expand:                     true;
    vertical-align:             0.5;
    margin:                     0px;
    background-color:           inherit;
    text-color:                 inherit;
}

mode-switcher {
    enabled:                    true;
    spacing:                    4px;
    padding:                    8px;
    background-color:           @bg;
    border:                     1px 0px 0px 0px;
    border-color:                @border-color;
}

button {
    padding:                    8px;
    background-color:           @button-bg;
    text-color:                 @fg;
    horizontal-align:            0.5;
    border-radius:               0px;
}

button selected {
    background-color:           @active;
    text-color:                 #ffffff;
    border-radius:               0px;
}

error-message {
    background-color:           @bg;
    text-color:                 @fg;
    border:                     1px;
    border-color:               @border-color;
    border-radius:              0px;
    padding:                    12px 16px;
}

textbox {
    background-color:           @bg;
    text-color:                 @fg;
    border-radius:              0px;
}
