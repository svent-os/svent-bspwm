#!/bin/sh
# Svent OS default bspwm keybindings. Adapted from z1rov's dotfiles.

# focus or send to desktop
super + {1-8}
    bspc desktop -f ^{1-8}
super + shift + {1-8}
    bspc node -d ^{1-8}

# terminal
super + Return
    sh -c 'cd ~ && exec kitty'

# screenshot full / region: save, copy to clipboard, notify
super + s
    sh -c 'DIR=~/Pictures/Clipboard; mkdir -p "$DIR"; \
    n=$(ls "$DIR" 2>/dev/null | grep -Eo "^img[0-9]+\.png$" | sed "s/[^0-9]//g" | sort -n | tail -1); \
    [ -z "$n" ] && n=0; next=$((n+1)); \
    IMG="$DIR/img$next.png"; \
    flameshot full -p "$IMG" && xclip -selection clipboard -t image/png -i "$IMG" && notify-send "Screenshot saved and copied" && pkill flameshot'
super + shift + s
    sh -c 'DIR=~/Pictures/Clipboard; mkdir -p "$DIR"; \
    n=$(ls "$DIR" 2>/dev/null | grep -Eo "^img[0-9]+\.png$" | sed "s/[^0-9]//g" | sort -n | tail -1); \
    [ -z "$n" ] && n=0; next=$((n+1)); \
    IMG="$DIR/img$next.png"; \
    flameshot gui -p "$IMG" && xclip -selection clipboard -t image/png -i "$IMG" && notify-send "Screenshot saved and copied"'

# session: poweroff, reboot, quit bspwm, lock, xkill, reload bspwm
ctrl + super + alt + {p,r,q,l,k,s}
    {systemctl poweroff, systemctl reboot, bspc quit, bash ~/.config/polybar/scripts/lock.sh, xkill, bspc wm -r}

# brightness and volume
XF86MonBrightness{Up,Down}
    brightnessctl set 5%{+,-}
XF86Audio{RaiseVolume,LowerVolume,Mute}
    pactl set-sink-{volume @DEFAULT_SINK@ +5%,volume @DEFAULT_SINK@ -5%,mute @DEFAULT_SINK@ toggle}

# media keys
XF86AudioPlay
    playerctl play-pause
XF86AudioNext
    playerctl next
XF86AudioPrev
    playerctl previous
XF86AudioStop
    playerctl stop
XF86AudioMicMute
    pactl set-source-mute @DEFAULT_SOURCE@ toggle && notify-send "Mic Toggle"

# radios
XF86WLAN
    sh -c 'rfkill toggle wifi; notify-send "WiFi toggle"'
XF86Bluetooth
    sh -c 'rfkill toggle bluetooth; notify-send "Bluetooth toggle"'

# bspwm control
super + alt + r
    bspc wm -r
super + Escape
    pkill -USR1 -x sxhkd
super + x
    bspc node -c
ctrl + Tab
    bspc node @/ --rotate {90,-90}
super + ctrl + r
    bspc node @/ --rotate 90
super + {Left,Right}
    bspc desktop -f {prev,next}
super + f
    bspc desktop -l next

# app launcher
super + d
    rofi -show drun

# wallpaper picker
super + w
    sh ~/.config/bspwm/scripts/wallpaper-menu.sh

# resize floating/tiled by edges
alt + Left
    bspc node -z right -20 0 || bspc node -z left -20 0
alt + Right
    bspc node -z right 20 0 || bspc node -z left 20 0
alt + Up
    bspc node -z bottom 0 -20 || bspc node -z top 0 -20
alt + Down
    bspc node -z bottom 0 20 || bspc node -z top 0 20

# preselect and parent resize
super + ctrl + {h,v,q}
    bspc node -p {east,south,cancel}
super + ctrl + {h,l}
    bspc node @parent -r {-0.1,+0.1}
super + ctrl + x
    bspc query -N -d | xargs -I id -n 1 bspc node id -c

# toggle floating
super + shift + space
    bspc node -t \~floating
