#!/bin/sh
set -eu
command -v flameshot >/dev/null 2>&1 || { notify-send 'Screenshot unavailable' 'Install flameshot.'; exit 1; }
dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"
case "${1:-region}" in
    full) flameshot full --path "$dir" --clipboard ;;
    region) flameshot gui --path "$dir" --clipboard ;;
    *) exit 2 ;;
esac
