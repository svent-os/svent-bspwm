super + {1-8}
    bspc desktop -f focused:^{1-8}
super + shift + {1-8}
    bspc node -d focused:^{1-8}
super + Return
    kitty
super + d
    rofi -show drun
super + t
    /usr/libexec/svent/bspwm/tools-menu.py
super + e
    thunar
super + w
    bash "${XDG_CONFIG_HOME:-$HOME/.config}/bspwm/scripts/wallpaper-menu.sh"
super + {h,j,k,l}
    bspc node -f {west,south,north,east}
super + shift + {h,j,k,l}
    bspc node -s {west,south,north,east}
super + {Left,Right}
    bspc desktop -f {prev,next}.local
super + x
    bspc node -c
super + f
    bspc desktop -l next
super + shift + f
    bspc node -t \~fullscreen
super + shift + space
    bspc node -t \~floating
super + ctrl + {h,v,q}
    bspc node -p {east,south,cancel}
super + ctrl + {Left,Right}
    bspc node @parent -r {-0.1,+0.1}
super + ctrl + r
    bspc node @/ --rotate 90
super + ctrl + x
    bspc query -N -d | xargs -r -I id bspc node id -c
alt + Left
    bspc node -z right -20 0 || bspc node -z left -20 0
alt + Right
    bspc node -z right 20 0 || bspc node -z left 20 0
alt + Up
    bspc node -z bottom 0 -20 || bspc node -z top 0 -20
alt + Down
    bspc node -z bottom 0 20 || bspc node -z top 0 20
super + alt + r
    bspc wm -r
super + Escape
    pkill -USR1 -x sxhkd
super + p
    bash "${XDG_CONFIG_HOME:-$HOME/.config}/polybar/scripts/power.sh"
super + shift + q
    bspc quit
super + ctrl + l
    bash "${XDG_CONFIG_HOME:-$HOME/.config}/polybar/scripts/lock.sh"
super + {s,shift + s}
    /usr/libexec/svent/bspwm/screenshot {full,region}
XF86MonBrightness{Up,Down}
    brightnessctl set 5%{+,-}
XF86Audio{RaiseVolume,LowerVolume,Mute}
    pactl set-sink-{volume @DEFAULT_SINK@ +5%,volume @DEFAULT_SINK@ -5%,mute @DEFAULT_SINK@ toggle}
XF86Audio{Play,Next,Prev,Stop}
    playerctl {play-pause,next,previous,stop}
XF86AudioMicMute
    pactl set-source-mute @DEFAULT_SOURCE@ toggle
XF86WLAN
    rfkill toggle wifi
XF86Bluetooth
    rfkill toggle bluetooth
