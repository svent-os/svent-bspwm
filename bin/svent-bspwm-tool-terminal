#!/usr/bin/env python3
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path


def tool_command(arguments):
    args = list(arguments)
    if args and args[0] in ("-e", "-x", "--"):
        args = args[1:]
    if len(args) == 1:
        args = shlex.split(args[0])
    if args and Path(args[0]).name == "svent-run":
        args = args[1:]
    return args


def main():
    arguments = sys.argv[1:]
    if arguments and arguments[0] == "--inside":
        command = arguments[1:]
        if command:
            print("$ " + shlex.join(command), flush=True)
            try:
                status = subprocess.run(command).returncode
            except OSError as error:
                print(str(error), file=sys.stderr)
                status = 127
            except KeyboardInterrupt:
                status = 130
            print(f"\n[SventOS] Tool exited ({status}). The shell remains open.\n", flush=True)
        shell = os.environ.get("SHELL", "/bin/zsh")
        if not shutil.which(shell):
            shell = "/bin/bash"
        os.execv(shell, [shell, "-i"])
        return
    command = tool_command(arguments)
    if not command:
        os.execvp("kitty", ["kitty"])
        return
    os.execvp("kitty", ["kitty", "--title", "SventOS Tools", "python3", str(Path(__file__).resolve()), "--inside", *command])


if __name__ == "__main__":
    main()
