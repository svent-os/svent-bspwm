#!/bin/sh
set -eu
[ "$(id -u)" -eq 0 ] || { printf '[-] Run as root.\n' >&2; exit 1; }
install_directory=/opt/svent-kitty-0.43.1
binary="$install_directory/kitty.app/bin/kitty"
if [ -x "$binary" ] && "$binary" --version | grep -Fq 'kitty 0.43.1'; then
    exit 0
fi
installer=$(mktemp /var/tmp/svent-kitty-installer-XXXXXXXX)
trap 'rm -f "$installer"' EXIT HUP INT TERM
curl --fail --show-error --location --proto '=https' --proto-redir '=https' \
    https://sw.kovidgoyal.net/kitty/installer.sh --output "$installer"
sh "$installer" installer=version-0.43.1 dest="$install_directory" launch=n
test -x "$binary"
"$binary" --version | grep -F 'kitty 0.43.1'
printf '[+] Kitty installed successfully.\n'
